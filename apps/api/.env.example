# Postgres connection string.
# Local (docker compose) uses the value below; in production point this at Neon
# or Supabase and keep the `?sslmode=require` their dashboard gives you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monitoring"

# Used only by the Prisma CLI for migrations. Needed where a connection
# pooler sits in front of Postgres — for Neon, the same host with
# `-pooler` removed — because migrations take a session-level advisory
# lock that a transaction pooler cannot hold.
# Unset locally and in CI, where there is no pooler.
# DIRECT_DATABASE_URL=""

# Port the API listens on. Render sets this itself; only override locally.
PORT=3000

# Comma-separated list of browser origins allowed to call the API.
# Include the Vercel preview domain as well as the production one.
CORS_ORIGINS="http://localhost:3001"

# Required for POST/PATCH. Reads are public by design; writes are not.
# With this unset the instance is read-only, which is the safe default for a
# public demo. Generate one with: openssl rand -hex 32
ADMIN_TOKEN="local-dev-token"

# Days of raw check history to keep. Read by the worker only — pruning happens
# there, not in the API. The worker prunes anything older on every
# run. Defaults to 90 — comfortably beyond the 30-day dashboard and status page
# windows. Set to 0 to keep everything.
RETENTION_DAYS="90"

# ---------------------------------------------------------------------------
# Alerting (optional — currently not enabled)
#
# Left unset everywhere, including the deployed demo. With no API key or sender
# address the mail transport is null and alerting is skipped, while the worker
# still records checks and incidents as normal.
# ---------------------------------------------------------------------------

RESEND_API_KEY=""

# Verified sender on your Resend domain, e.g. "alerts@status.example.com".
ALERT_FROM_EMAIL=""

# Used for endpoints that have alerting enabled but no address of their own.
ALERT_TO_EMAIL=""

# Linked from alert emails so a recipient can get to the dashboard.
DASHBOARD_URL=""
