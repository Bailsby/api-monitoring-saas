generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MonitoredEndpoint {
  id        String   @id @default(cuid())
  url       String   @unique
  createdAt DateTime @default(now())

  /// Consecutive failed checks before an incident opens. Configurable per
  /// endpoint so a flaky endpoint can be made less noisy without affecting others.
  failureThreshold Int @default(2)

  /// Display name and shareable slug for the public status page. An endpoint
  /// is only reachable publicly once it has a slug and isPublic is set.
  name     String?
  slug     String? @unique
  isPublic Boolean @default(false)

  alertsEnabled Boolean @default(false)
  /// Falls back to ALERT_TO_EMAIL when unset.
  alertEmail    String?

  checks    EndpointCheck[]
  incidents Incident[]
}

model EndpointCheck {
  id           String   @id @default(cuid())
  statusCode   Int?
  responseTime Int
  isUp         Boolean
  checkedAt    DateTime @default(now())

  errorType    String?

  endpointId String
  endpoint   MonitoredEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, checkedAt])
}

model Incident {
  id         String    @id @default(cuid())
  startedAt  DateTime
  resolvedAt DateTime?
  /// Error type of the check that opened the incident, e.g. "http_error".
  cause      String
  /// Populated on resolution; null while the incident is ongoing.
  durationMs Int?

  /// Alert bookkeeping. Stamped once per incident per transition, so a
  /// notification is sent for the incident rather than for every failed check.
  openAlertSentAt     DateTime?
  resolvedAlertSentAt DateTime?

  endpointId String
  endpoint   MonitoredEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, startedAt])
  @@index([resolvedAt])
}

model WorkerRun {
  id            String   @id @default(cuid())
  startedAt     DateTime
  durationMs    Int
  total         Int
  successful    Int
  failures      Int
  createdAt     DateTime @default(now())
}
