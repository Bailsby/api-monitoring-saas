generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MonitoredEndpoint {
  id        String          @id @default(cuid())
  url       String
  createdAt DateTime        @default(now())

  checks    EndpointCheck[]
}

model EndpointCheck {
  id           String   @id @default(cuid())
  statusCode   Int?
  responseTime Int
  isUp         Boolean
  checkedAt    DateTime @default(now())

  errorType    String?

  endpointId String
  endpoint   MonitoredEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model WorkerRun {
  id            String   @id @default(cuid())
  startedAt     DateTime
  durationMs    Int
  total         Int
  successful    Int
  failures      Int
  createdAt     DateTime @default(now())
}