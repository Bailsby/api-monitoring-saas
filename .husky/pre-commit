echo "🔥 Running lint-staged..."
npx lint-staged

echo "🔥 Running lint..."
npm run lint

echo "🔥 Checking for API changes..."

if git diff --cached --name-only | grep '^apps/api/' > /dev/null; then
  echo "🧪 API changes detected — running tests..."
  npm run test --prefix apps/api
else
  echo "✅ No API changes — skipping tests"
fi

echo "🎉 Pre-commit complete"